# set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(TARGET_TRIPLE x86_64-pc-windows-gnu)
if(NOT DEFINED ENV{MINGW_BASE})
    message(STATUS "Setting default MinGW base install: /usr")
    set(MINGW_BASE "/usr")
else()
    set(MINGW_BASE $ENV{MINGW_BASE})
endif()
set(MINGW_PREFIX ${MINGW_BASE}/bin/x86_64-w64-mingw32)
set(MINGW_ROOT ${MINGW_BASE}/x86_64-w64-mingw32)

set(CMAKE_C_COMPILER ${MINGW_PREFIX}-gcc)
set(CMAKE_C_COMPILER_TARGET ${TARGET_TRIPLE})
set(CMAKE_CXX_COMPILER ${MINGW_PREFIX}-g++)
set(CMAKE_CXX_COMPILER_TARGET ${TARGET_TRIPLE})
set(CMAKE_RC_COMPILER ${MINGW_PREFIX}/bin/windres)

# message(STATUS "Using CXX compiler: ${CMAKE_CXX_COMPILER}")
# message(STATUS "Using find root path: ${MINGW_ROOT}")

set(CMAKE_CXX_STDLIB_MODULES_JSON "${MINGW_ROOT}/lib/libstdc++.modules.json" CACHE PATH "Force standard module json path" FORCE)
# message(STATUS "CMAKE_CXX_STDLIB_MODULES_JSON: ${CMAKE_CXX_STDLIB_MODULES_JSON}")

set(CMAKE_FIND_ROOT_PATH ${MINGW_ROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
